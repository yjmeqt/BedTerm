        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Linux / 기타" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Linux или другое" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Linux / 其他" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Linux / 其他" } }
      }
    },
    "Linux box, VM, Raspberry Pi, cloud server" : {
