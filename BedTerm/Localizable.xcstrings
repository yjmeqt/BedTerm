{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {
    "%@:%lld presented a different host key than we trusted last time. " : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%1$@:%2$lld は前回信頼したホストキーとは異なるホストキーを提示しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%1$@:%2$lld 호스트가 이전에 신뢰한 호스트 키와 다른 키를 제시했습니다. " } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%1$@:%2$lld предъявил ключ хоста, отличный от того, которому мы доверяли в прошлый раз. " } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@:%2$lld 提供的主机密钥与上次信任的不一致。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%1$@:%2$lld 提供的主機金鑰與上次信任的不一致。" } }
      }
    },
    "This could mean the server was reinstalled — or that someone is intercepting the connection." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サーバーが再インストールされた可能性、または通信が傍受されている可能性があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "서버가 재설치되었거나 누군가 연결을 가로채고 있을 수 있습니다." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это может означать, что сервер был переустановлен — или что кто-то перехватывает соединение." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可能是服务器被重装，也可能有人正在拦截连接。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可能是伺服器已重新安裝，也可能有人正在攔截連線。" } }
      }
    },
    "A Mac mini, MacBook, or iMac on your network" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ネットワーク上の Mac mini、MacBook、iMac など" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "네트워크에 연결된 Mac mini, MacBook, iMac 등" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Mac mini, MacBook или iMac в вашей сети" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "局域网中的 Mac mini、MacBook 或 iMac" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "區域網路中的 Mac mini、MacBook 或 iMac" } }
      }
    },
    "A public IP or hostname reachable from anywhere" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "どこからでも到達できる公開 IP またはホスト名" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "어디서나 접근 가능한 공인 IP 또는 호스트 이름" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Публичный IP-адрес или имя хоста, доступные из любой сети" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公网可达的 IP 地址或主机名" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "公網可達的 IP 位址或主機名稱" } }
      }
    },
    "All set" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "準備完了" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "준비 완료" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Готово" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "全部就绪" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "全部就緒" } }
      }
    },
    "Authentication" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "認証" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "인증" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Аутентификация" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "认证方式" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "認證方式" } }
      }
    },
    "Authentication failed." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "認証に失敗しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "인증에 실패했습니다." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ошибка аутентификации." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "认证失败。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "認證失敗。" } }
      }
    },
    "BedTerm needs Local Network access to reach your Mac on the same Wi-Fi. Tap Allow when iOS prompts you." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "同じ Wi-Fi 上の Mac に接続するには、BedTerm にローカルネットワークへのアクセスが必要です。iOS の確認ダイアログで「許可」をタップしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "같은 Wi-Fi의 Mac에 접근하려면 BedTerm에 로컬 네트워크 권한이 필요합니다. iOS 알림이 나타나면 '허용'을 누르세요." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Чтобы подключиться к Mac в той же сети Wi-Fi, BedTerm нужен доступ к локальной сети. Нажмите «Разрешить», когда iOS запросит разрешение." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "BedTerm 需要本地网络权限才能访问同一 Wi-Fi 下的 Mac。系统弹窗出现时请点击「允许」。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "BedTerm 需要區域網路權限才能存取同一 Wi-Fi 下的 Mac。系統彈出視窗時請點擊「允許」。" } }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャンセル" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "취소" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отмена" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "取消" } }
      }
    },
    "Cannot parse private key." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "秘密鍵を解析できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "개인 키를 해석할 수 없습니다." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось разобрать закрытый ключ." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法解析私钥。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法解析私密金鑰。" } }
      }
    },
    "Cannot resolve host." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストを解決できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트를 확인할 수 없습니다." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось разрешить имя хоста." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法解析主机地址。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法解析主機位址。" } }
      }
    },
    "Closed" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "切断しました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결을 종료했습니다" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Соединение закрыто" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已关闭" } },
