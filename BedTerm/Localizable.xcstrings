    "On your Mac, open System Settings → General → Sharing, then turn on Remote Login. (Detailed walkthrough coming soon.)" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Mac で「システム設定 → 一般 → 共有」を開き、「リモートログイン」をオンにしてください。（詳しい手順は近日公開予定です。）" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Mac에서 시스템 설정 → 일반 → 공유로 이동해 원격 로그인을 켜 주세요. (자세한 안내는 곧 제공될 예정입니다.)" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "На Mac откройте «Системные настройки → Основные → Общий доступ» и включите удалённый вход. (Подробное руководство скоро появится.)" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 Mac 上打开「系统设置 → 通用 → 共享」，开启「远程登录」。（详细教程即将推出。）" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 Mac 上開啟「系統設定 → 一般 → 共享」，啟用「遠端登入」。（詳細教學即將推出。）" } }
