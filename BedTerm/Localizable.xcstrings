        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "查看 Mac 的 IP 位址" } }
      }
    },
    "Host" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホスト" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Хост" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主机" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "主機" } }
      }
    },
    "Host key changed" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストキーが変更されました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 키가 변경되었습니다" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ключ хоста изменился" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主机密钥已变更" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "主機金鑰已變更" } }
      }
    },
    "Host key changed.\nStored: %1$@\nRemote: %2$@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストキーが変更されました。\n保存済み: %1$@\nリモート: %2$@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 키가 변경되었습니다.\n저장된 키: %1$@\n원격 키: %2$@" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ключ хоста изменился.\nСохранённый: %1$@\nУдалённый: %2$@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主机密钥已变更。\n已存储：%1$@\n远端：%2$@" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "主機金鑰已變更。\n已儲存：%1$@\n遠端：%2$@" } }
