{
  "sourceLanguage": "en",
  "strings": {
    "%@:%lld presented a different host key than we trusted last time. ": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld は前回信頼したホストキーとは異なるホストキーを提示しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld 호스트가 이전에 신뢰한 호스트 키와 다른 키를 제시했습니다. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld предъявил ключ хоста, отличный от того, которому мы доверяли в прошлый раз. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld 提供的主机密钥与上次信任的不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld 提供的主機金鑰與上次信任的不一致。"
          }
        }
      }
    },
    "(no command captured)": {
