    },
    "Connection refused — check host and port." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続が拒否されました。ホストとポートを確認してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결이 거부되었습니다. 호스트와 포트를 확인하세요." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Соединение отклонено — проверьте хост и порт." } },
