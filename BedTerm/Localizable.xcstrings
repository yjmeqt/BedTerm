        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Соединение завершено" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接已结束" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連線已結束" } }
