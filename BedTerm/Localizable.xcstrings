    },
    "Host, port and username are required." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホスト、ポート、ユーザー名は必須です。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트, 포트, 사용자 이름은 필수입니다." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Укажите хост, порт и имя пользователя." } },
