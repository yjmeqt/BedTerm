        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請填寫主機、連接埠與使用者名稱。" } }
      }
    },
    "iOS will ask for Local Network permission" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iOS がローカルネットワークの許可を確認します" } },
