    },
    "Find your Mac's IP address" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Mac の IP アドレスを確認する" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Mac의 IP 주소 확인" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Узнайте IP-адрес вашего Mac" } },
